# ==============================================================================
# KSM-INSTITUTIONAL-QUANT: ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate with your own credentials.
# NEVER commit your actual .env file to public version control.
# ==============================================================================

# 1. MetaTrader 5 / Exness Broker Credentials (Required for Live Execution)
EXNESS_MT5_LOGIN=12345678
EXNESS_MT5_PASSWORD=YourSecureMT5PasswordHere
EXNESS_MT5_SERVER=Exness-MT5Trial6
# Path to 64-bit terminal executable (Optional if MT5 is in default standard directory)
# EXNESS_MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe"

# 2. System 1 AI Decision Gatekeepers (Optional)
# Primary Cloud Engine: TypeSafe Jev System One API (Apex semantic triage)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# Tertiary Local Backup: Hugging Face / Model Hub Token (For downloading weights)
HF_TOKEN=your_huggingface_token_here

# 3. Real-Time Telemetry & Telegram Notifier (Optional)
# Bot token created via @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Your personal or channel Telegram Chat ID
TELEGRAM_CHAT_ID=123456789

# 4. Cloud HPC Acceleration (Optional)
# Camber Cloud HPC API key for distributed multi-decade backtesting
CAMBER_API_KEY=your_camber_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
